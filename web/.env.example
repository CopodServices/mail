# --- cPOD Mail web client ---------------------------------------------------
# Base URL for API calls, baked into the bundle at build time.
#   empty            -> use same-origin /api/* (the container proxies to the API)
#   absolute origin  -> call the API directly, e.g. http://localhost:8080
NEXT_PUBLIC_MAIL_API_URL=

# Credit link shown in the sidebar footer (AGPL-3.0 network-source obligation).
NEXT_PUBLIC_SOURCE_URL=https://github.com/copodservices/mail

# --- Runtime (container only, not baked into the bundle) --------------------
# Where nginx forwards /api/* inside the webmail image. A bare origin, no
# trailing slash: the /api prefix is forwarded unchanged.
MAIL_API_URL=http://mail-api:8080
