# Copy to .env. The values below work out of the box against compose.yml.

DATABASE_URL=postgres://cpod:cpod@localhost:5432/cpod

# Secret for webmail session cookies (HS256). Use a long random value in
# production: openssl rand -base64 32
SESSION_SECRET=bWFpbC1kZXYtc2Vzc2lvbi1zZWNyZXQtMzJieXRlcyE=
# Marks the session cookie Secure. Keep true behind HTTPS; set false only when
# the app is served over plain HTTP.
SESSION_COOKIE_SECURE=true
# SameSite policy for the session cookies: lax (default) | none | strict.
# A webmail served from another site than the API needs none, which implies
# Secure (browsers reject SameSite=None without it).
# Bearer token for the operator API, which manages every tenant (domains and
# mailboxes). Leave empty to disable authentication (dev only).
API_KEY=

SERVER_PORT=8080
SMTP_LISTEN=0.0.0.0:2525
SUBMISSION_LISTEN=0.0.0.0:2587
# Reader listeners: IMAP and POP3 for another mail app. Comment either out to
# leave that reader off entirely. Locally there is no certificate, so these
# serve plaintext; production uses 0.0.0.0:993 and 0.0.0.0:995 with TLS.
IMAP_LISTEN=0.0.0.0:1993
POP3_LISTEN=0.0.0.0:1995
MAIL_HOSTNAME=mx.example.test

# Domains this server accepts mail for. A postmaster mailbox is seeded for each
# when MAIL_BOOTSTRAP_PASSWORD is set.
MAIL_DOMAINS=example.test
MAIL_BOOTSTRAP_PASSWORD=devpostmaster

MAX_MESSAGE_SIZE=26214400
MAX_RECIPIENTS=50
# Verify SPF/DKIM/DMARC on inbound mail (disable for fully offline work).
MAIL_VERIFY_AUTH=true

# Object storage: s3mock locally, Cloudflare R2 or S3 in production.
S3_ENDPOINT=http://localhost:9090
S3_REGION=us-east-1
S3_BUCKET=copod-mail
S3_ACCESS_KEY=cpod
S3_SECRET_KEY=cpod12345
S3_PATH_STYLE=true
S3_ALLOW_HTTP=true

# Smarthost for every outbound message. The provider is a configuration choice:
# any SMTP relay works, so these values are the only place one is named. Locally
# it is Mailpit; the commented example below is Jetemail (see the Relay section
# of README.md).
#   RELAY_HOST=relay.jetsmtp.net       (EU: relay-eu.jetsmtp.net)
#   RELAY_PORT=587
#   RELAY_TLS=starttls
#   RELAY_USERNAME / RELAY_PASSWORD    an SMTP credential from the provider
# The provider signs DKIM, so publish the authentication records it lists for
# each tenant domain (typically SPF, a return-path CNAME, a DKIM CNAME and
# DMARC) plus an MX pointing at this service.
RELAY_HOST=localhost
RELAY_PORT=1025
RELAY_USERNAME=
RELAY_PASSWORD=
# none | starttls | implicit
RELAY_TLS=none
# Optional envelope sender rewrite required by some relays.
RELAY_FROM=
RELAY_MAX_ATTEMPTS=8
QUEUE_INTERVAL_SECS=5

# Optional PEM pair enabling STARTTLS on both listeners (unset locally).
TLS_CERT_PATH=
TLS_KEY_PATH=
# ---------------------------------------------------------------------------
# Antispam (off by default). See docs/antispam.md and config/spam.example.json.
# ---------------------------------------------------------------------------
# off | log | quarantine. Run log first: it records verdicts but never junk.
SPAM_MODE=off
# Path to the JSON config holding thresholds, the tag -> score map, DNSBL
# zones, rules and scanner endpoints.
SPAM_CONFIG_PATH=./config/spam.example.json
# Required once SPAM_MODE is not off: greylisting, rate limits and caches.
REDIS_URL=redis://127.0.0.1:6379
# Fallback junk threshold when the config file sets none.
SPAM_JUNK_SCORE=5.0
# Optional DNS resolver for DNSBL/URIBL (an ip or ip:port), used for both the
# inbound authentication checks and the blocklists.
SPAM_DNS_RESOLVER=
# Extra blocklist zones (comma separated): peer IP zones and link/domain zones.
SPAM_DNSBL_ZONES=
SPAM_URIBL_ZONES=
# Seconds between classifier rebuilds from the training reservoir.
SPAM_TRAIN_INTERVAL=3600
# Greylisting and per-IP rate limiting are opt-in.
SPAM_GREYLIST=false
SPAM_RATELIMIT=false
# Allow real reject/discard actions; left off, junk is always quarantined.
SPAM_ALLOW_REJECT=false
# Optional community ruleset and scanner endpoints.
SPAM_RULES_URL=
CLAMAV_ADDR=
OLEFY_URL=
TIKA_URL=
SPAM_DEBUG=false
